# Copy this file to .env. The real .env is ignored by Git.
# DeepSeek Official API is the default, reproducible demo path.
LINEAGEGUARD_LLM_PROVIDER=deepseek
LINEAGEGUARD_LLM_API_KEY=
LINEAGEGUARD_LLM_MODEL=deepseek-v4-flash
LINEAGEGUARD_LLM_THINKING=false

# To use OpenRouter instead, change the provider and model above to:
# LINEAGEGUARD_LLM_PROVIDER=openrouter
# LINEAGEGUARD_LLM_MODEL=deepseek/deepseek-v4-flash
# Optional OpenRouter controls:
# Leave provider routing unset unless you have verified an eligible provider slug.
# LINEAGEGUARD_OPENROUTER_PROVIDER=deepseek
# LINEAGEGUARD_OPENROUTER_ZDR=false

# Optional authenticated DataHub settings for the full MCP workflow:
# DATAHUB_GMS_URL=http://localhost:8080
# DATAHUB_GMS_TOKEN=
